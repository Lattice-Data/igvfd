{
    "title": "Human Donor",
    "$id": "/profiles/human_donor.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Schema for human research subjects and donors.",
    "type": "object",
    "required": [
        "lab",
        "taxa",
        "cxg_donor_id"
    ],
    "identifyingProperties": [
        "uuid",
        "aliases"
    ],
    "additionalProperties": false,
    "mixinProperties": [
        {
            "$ref": "mixins.json#/basic_item"
        },
        {
            "$ref": "mixins.json#/attribution"
        },
        {
            "$ref": "mixins.json#/shared_status"
        },
        {
            "$ref": "mixins.json#/author_metadata"
        },
        {
            "$ref": "donor.json#/properties"
        }
    ],
    "properties": {
        "schema_version": {
            "default": "5"
        },
        "taxa": {
            "title": "Taxa",
            "type": "string",
            "description": "The species of the organism.",
            "comment": "Link to the NCBITaxon ControlledTerm for Homo sapiens. See controlled_term.json for available identifiers.",
            "linkTo": "ControlledTerm",
            "validators": [
                "isAllowedTerm"
            ],
            "allowedTerms": {
                "NCBITaxon:9606": "Homo sapiens"
            },
            "submissionExample": {
                "appscript": "lattice:ncbitaxon_homo_sapiens"
            }
        },
        "sex": {
            "title": "Sex",
            "description": "Biological sex of the donor.",
            "type": "string",
            "default": "unspecified",
            "enum": [
                "female",
                "male",
                "mixed",
                "unspecified"
            ]
        },
        "ethnicities": {
            "title": "Ethnicities",
            "description": "The ethnicities of the human donor.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "title": "Ethnicity",
                "description": "An ethnicity of the human donor.",
                "comment": "Link to ControlledTerm with ethnicity ontology terms.",
                "type": "string",
                "linkTo": "ControlledTerm"
            }
        }
    },
    "fuzzy_searchable_fields": [
        "aliases",
        "cxg_donor_id",
        "description",
        "taxa.term_name",
        "ethnicities"
    ],
    "exact_searchable_fields": [
        "@type"
    ],
    "changelog": "/profiles/changelogs/human_donor.md"
}
