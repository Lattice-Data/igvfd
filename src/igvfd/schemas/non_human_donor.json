{
    "title": "Non Human Donor",
    "$id": "/profiles/non_human_donor.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Schema for non human donors.",
    "type": "object",
    "required": [
        "lab",
        "taxa",
        "cxg_donor_id"
    ],
    "identifyingProperties": [
        "uuid",
        "aliases"
    ],
    "additionalProperties": false,
    "mixinProperties": [
        {
            "$ref": "mixins.json#/basic_item"
        },
        {
            "$ref": "mixins.json#/attribution"
        },
        {
            "$ref": "mixins.json#/shared_status"
        },
        {
            "$ref": "mixins.json#/author_metadata"
        },
        {
            "$ref": "donor.json#/properties"
        }
    ],
    "properties": {
        "schema_version": {
            "default": "4"
        },
        "taxa": {
            "title": "Taxa",
            "type": "string",
            "description": "The species of the organism.",
            "comment": "Link to an NCBITaxon ControlledTerm for one of the allowed species. See controlled_term.json for available identifiers.",
            "linkTo": "ControlledTerm",
            "validators": [
                "isAllowedTerm"
            ],
            "allowedTerms": {
                "NCBITaxon:8496": "Alligator mississippiensis",
                "NCBITaxon:28377": "Anolis carolinensis",
                "NCBITaxon:10201": "Beroe ovata",
                "NCBITaxon:6526": "Biomphalaria glabrata",
                "NCBITaxon:8478": "Chrysemys picta bellii",
                "NCBITaxon:7719": "Ciona intestinalis",
                "NCBITaxon:93934": "Coturnix japonica",
                "NCBITaxon:7955": "Danio rerio",
                "NCBITaxon:153281": "Euprymna berryi",
                "NCBITaxon:216498": "Hydroides elegans",
                "NCBITaxon:7782": "Leucoraja erinaceus",
                "NCBITaxon:6850": "Limulus polyphemus",
                "NCBITaxon:31216": "Littorina littorea",
                "NCBITaxon:27923": "Mnemiopsis leidyi",
                "NCBITaxon:13616": "Monodelphis domestica",
                "NCBITaxon:10090": "Mus musculus",
                "NCBITaxon:7769": "Myxine glutinosa",
                "NCBITaxon:45351": "Nematostella vectensis",
                "NCBITaxon:105023": "Nothobranchius furzeri",
                "NCBITaxon:37653": "Octopus bimaculoides",
                "NCBITaxon:317513": "Parhyale hawaiensis",
                "NCBITaxon:46514": "Patiria miniata",
                "NCBITaxon:7757": "Petromyzon marinus",
                "NCBITaxon:3269935": "Platynereis megalops",
                "NCBITaxon:111125": "Ranitomeya imitator",
                "NCBITaxon:10224": "Saccoglossus kowalevskii",
                "NCBITaxon:7710": "Sclerodactyla briareus",
                "NCBITaxon:27933": "Sycon ciliatum",
                "NCBITaxon:308579": "Turritopsis dohrnii",
                "NCBITaxon:8364": "Xenopus tropicalis"
            },
            "submissionExample": {
                "appscript": "lattice:term-mus-musculus"
            }
        },
        "sex": {
            "title": "Sex",
            "description": "Biological sex of the donor.",
            "type": "string",
            "default": "unspecified",
            "comment": "Hermaphrodite is expected only for hermaphroditic species. An audit flags it on other species.",
            "enum": [
                "female",
                "hermaphrodite",
                "male",
                "mixed",
                "unspecified"
            ]
        }
    },
    "fuzzy_searchable_fields": [
        "aliases",
        "cxg_donor_id",
        "description",
        "taxa.term_name"
    ],
    "exact_searchable_fields": [
        "@type"
    ],
    "changelog": "/profiles/changelogs/non_human_donor.md"
}
