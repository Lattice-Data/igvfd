{
    "title": "Experimental Condition",
    "$id": "/profiles/experimental_condition.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Experimental conditions, environmental parameters, and treatments that affect biological samples during culture or experimental procedures.",
    "type": "object",
    "required": [
        "lab",
        "condition"
    ],
    "identifyingProperties": [
        "uuid",
        "aliases"
    ],
    "additionalProperties": false,
    "mixinProperties": [
        {
            "$ref": "mixins.json#/basic_item"
        },
        {
            "$ref": "mixins.json#/attribution"
        },
        {
            "$ref": "mixins.json#/shared_status"
        },
        {
            "$ref": "mixins.json#/duration_range"
        }
    ],
    "dependentSchemas": {
        "$merge": [
            "mixins.json#/duration_range_dependent_schemas"
        ],
        "condition": {
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "enum": [
                                    "humidity",
                                    "osmolarity",
                                    "oxygen level",
                                    "pH",
                                    "pressure",
                                    "surface tension",
                                    "temperature"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "units",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "enum": [
                                    "diet",
                                    "smoking status"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "text_value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "condition": {
                                "enum": [
                                    "chemical treatment",
                                    "protein treatment"
                                ]
                            }
                        }
                    },
                    "then": {
                        "anyOf": [
                            {
                                "required": [
                                    "controlled_term"
                                ]
                            },
                            {
                                "required": [
                                    "text_value"
                                ]
                            }
                        ],
                        "properties": {
                            "units": {
                                "enum": [
                                    "mg/kg",
                                    "mg/mL",
                                    "mM",
                                    "ng/mL",
                                    "nM",
                                    "percent",
                                    "μg/kg",
                                    "μg/mL",
                                    "μM",
                                    "kPa"
                                ]
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "units": {
                                "not": {
                                    "enum": [
                                        "mg/kg",
                                        "mg/mL",
                                        "mM",
                                        "ng/mL",
                                        "nM",
                                        "μg/kg",
                                        "μg/mL",
                                        "μM"
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "value": {
            "required": [
                "units"
            ]
        },
        "units": {
            "required": [
                "value"
            ]
        }
    },
    "properties": {
        "schema_version": {
            "default": "2"
        },
        "condition": {
            "title": "Condition",
            "description": "Type of experimental condition, parameter, or treatment.",
            "type": "string",
            "enum": [
                "chemical treatment",
                "diet",
                "humidity",
                "osmolarity",
                "oxygen level",
                "pH",
                "pressure",
                "protein treatment",
                "smoking status",
                "surface tension",
                "temperature"
            ]
        },
        "controlled_term": {
            "title": "Controlled Term",
            "description": "Ontology term describing this condition (for example a diet term), or the treatment agent for treatment conditions (a ChEBI term for chemical treatments, a UniProt term for protein treatments).",
            "comment": "See controlled_term.json for available identifiers. For chemical treatment and protein treatment, either controlled_term or text_value is required. This property is affected by dependencies. See dependentSchemas.",
            "type": "string",
            "linkTo": "ControlledTerm",
            "submissionExample": {
                "appscript": "lattice:term-high-fat-diet"
            }
        },
        "value": {
            "title": "Value",
            "description": "Numeric value of the condition, or the amount of the treatment agent applied.",
            "comment": "Required for quantitative conditions. This property is affected by dependencies. See dependentSchemas.",
            "type": "number"
        },
        "units": {
            "title": "Units",
            "description": "Units of measurement for the condition value or treatment amount.",
            "comment": "Required for quantitative conditions. Treatment conditions accept only amount units (mg/kg, mg/mL, mM, ng/mL, nM, percent, μg/kg, μg/mL, μM, kPa); other conditions do not accept mg/kg, mg/mL, mM, ng/mL, nM, μg/kg, μg/mL, or μM. This property is affected by dependencies. See dependentSchemas.",
            "type": "string",
            "enum": [
                "celsius",
                "dyn/cm",
                "fahrenheit",
                "kelvin",
                "kPa",
                "mg/kg",
                "mg/mL",
                "mM",
                "mN/m",
                "mOsm/kg",
                "mmHg",
                "ng/mL",
                "nM",
                "percent",
                "pH units",
                "μg/kg",
                "μg/mL",
                "μM"
            ]
        },
        "text_value": {
            "title": "Text Value",
            "description": "Text description of the condition for qualitative parameters, or the name of the treatment agent when no ontology term is available.",
            "comment": "Required for qualitative conditions (e.g. diet, smoking status). For chemical treatment and protein treatment, either controlled_term or text_value is required. This property is affected by dependencies. See dependentSchemas.",
            "type": "string",
            "pattern": "^(\\S+(\\s|\\S)*\\S+|\\S)$"
        }
    },
    "fuzzy_searchable_fields": [
        "aliases",
        "description",
        "condition",
        "text_value"
    ],
    "exact_searchable_fields": [
        "@type",
        "condition"
    ],
    "changelog": "/profiles/changelogs/experimental_condition.md"
}
