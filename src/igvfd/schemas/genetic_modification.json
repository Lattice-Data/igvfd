{
    "title": "Genetic Modification",
    "$id": "/profiles/genetic_modification.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Genetic modifications applied to biological samples, including CRISPR-based and other genetic engineering techniques.",
    "type": "object",
    "required": [
        "strategy"
    ],
    "identifyingProperties": [
        "uuid",
        "aliases"
    ],
    "additionalProperties": false,
    "dependentSchemas": {
        "targeted_genes": {
            "properties": {
                "strategy": {
                    "const": "knockout mutation"
                }
            }
        }
    },
    "mixinProperties": [
        {
            "$ref": "mixins.json#/basic_item"
        },
        {
            "$ref": "mixins.json#/shared_status"
        }
    ],
    "properties": {
        "schema_version": {
            "default": "2"
        },
        "strategy": {
            "title": "Strategy",
            "description": "The purpose or intended effect of the genetic modification.",
            "type": "string",
            "enum": [
                "activation screen",
                "base editing screen",
                "cutting screen",
                "interference screen",
                "knockout screen",
                "localizing screen",
                "prime editing screen",
                "knockout mutation"
            ]
        },
        "guide_rna_files": {
            "title": "Guide RNA Files",
            "description": "TSV file(s) listing the guide RNAs and associated metadata used to generate this genetic modification.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "title": "Guide RNA File",
                "description": "A tabular file containing CRISPR guide RNA information.",
                "comment": "See tabular_file.json for available identifiers.",
                "type": "string",
                "linkTo": "TabularFile"
            },
            "submissionExample": {
                "appscript": "[\"igvfd-files:guide-rna-table\"]"
            }
        },
        "targeted_genes": {
            "title": "Targeted Genes",
            "description": "Gene(s) targeted by the genetic modification. Applicable only when strategy is 'knockout mutation'.",
            "comment": "This property is affected by dependencies. See genetic_modification.json.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "title": "Targeted Gene",
                "description": "A gene targeted by the genetic modification.",
                "type": "string"
            },
            "submissionExample": {
                "appscript": "[\"TP53\", \"EGFR\"]"
            }
        }
    },
    "fuzzy_searchable_fields": [
        "aliases",
        "description"
    ],
    "exact_searchable_fields": [
        "@type",
        "strategy"
    ],
    "changelog": "/profiles/changelogs/genetic_modification.md"
}
