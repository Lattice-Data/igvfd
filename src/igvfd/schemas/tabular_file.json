{
    "title": "Tabular File",
    "$id": "/profiles/tabular_file.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A file containing tabular data in CSV or TSV format.",
    "type": "object",
    "required": [
        "lab",
        "file_format",
        "content_type"
    ],
    "identifyingProperties": [
        "uuid",
        "aliases",
        "guides_signature"
    ],
    "additionalProperties": false,
    "mixinProperties": [
        {
            "$ref": "mixins.json#/basic_item"
        },
        {
            "$ref": "mixins.json#/attribution"
        },
        {
            "$ref": "mixins.json#/shared_status"
        },
        {
            "$ref": "file.json#/properties"
        }
    ],
    "allOf": [
        {
            "$merge": [
                "file.json#/allOf/0"
            ]
        }
    ],
    "dependentSchemas": {
        "content_type": {
            "if": {
                "properties": {
                    "content_type": {
                        "enum": [
                            "guide RNA sequences"
                        ]
                    }
                }
            },
            "then": {
                "required": [
                    "guides_signature"
                ]
            }
        }
    },
    "properties": {
        "schema_version": {
            "default": "5"
        },
        "file_format": {
            "title": "File Format",
            "description": "The file format or extension of the file.",
            "type": "string",
            "enum": [
                "csv",
                "tsv"
            ],
            "submissionExample": {
                "appscript": "csv"
            }
        },
        "content_type": {
            "title": "Content Type",
            "description": "Describes the content of the tabular file.",
            "comment": "Additional enum values will be added as new tabular content types are supported.",
            "type": "string",
            "enum": [
                "guide RNA sequences"
            ],
            "enum_descriptions": {
                "guide RNA sequences": "The sequences of guide RNAs designed for genome editing using CRISPR."
            },
            "submissionExample": {
                "appscript": "guide RNA sequences"
            }
        },
        "guides_signature": {
            "title": "Guides Signature",
            "description": "A signature identifying the exact set of guide RNA sequences contained in the file.",
            "comment": "Required when content_type is guide RNA sequences. The value has the form gsig1:set:n=<number of guides>:<32-character lowercase hexadecimal digest>, and must be unique across the portal - two files cannot declare the same guide set. This property is affected by dependencies. See dependentSchemas.",
            "type": "string",
            "pattern": "^gsig1:set:n=\\d+:[0-9a-f]{32}$",
            "submissionExample": {
                "appscript": "gsig1:set:n=1000:7d41ba0e63c95f28a04e1db7f6c3820a"
            }
        }
    },
    "fuzzy_searchable_fields": [
        "aliases",
        "description"
    ],
    "exact_searchable_fields": [
        "@type",
        "guides_signature"
    ],
    "changelog": "/profiles/changelogs/tabular_file.md"
}
